{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "clockwork",
      "camelcase": "Clockwork",
      "title": "Clockwork",
      "scope": "source.clockwork",
      "file-types": [
        ".lpc",
        ".cw"
      ],
      "injection-regex": "^clockwork$",
      "class-name": "TreeSitterClockwork"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Clockwork language",
    "authors": [
      {
        "name": "Martin Leadbeater",
        "email": "mleadbeater@me.com"
      }
    ],
    "links": {
      "repository": "https://github.com/mleadbeater/neovim-kickstart.nvim.git"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
