{
  "name": "tree-sitter-clockwork",
  "version": "0.1.0",
  "description": "Clockwork language",
  "repository": "https://github.com/mleadbeater/neovim-kickstart.nvim.git",
  "license": "MIT",
  "author": {
    "name": "Martin Leadbeater",
    "email": "mleadbeater@me.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "clockwork"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
